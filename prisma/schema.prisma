


generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum SystemRole {
  OWNER
  MANAGER
  MEMBER
}

enum LicenseStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  REVOKED
}

enum LicenseEdition {
  TRIAL
  STANDARD
  PRO
  ENTERPRISE
}

model SystemSetting {
  wizardCompletedAt DateTime? @map("wizard_completed_at") @db.Timestamptz(3)
  wizardChoice String? @map("wizard_choice")
  wizardActivation WizardActivation?
  id              String  @id @default(uuid()) @db.Uuid
  singletonKey    String  @unique @default("system") @map("singleton_key")
  companyName     String  @default("Meetwise") @map("company_name")
  companyLogoUrl  String? @map("company_logo_url")
  timezone        String  @default("UTC")
  defaultLanguage String  @default("en") @map("default_language")
  defaultBotName  String  @default("Meetwise Bot") @map("default_bot_name")

  recordingConsentRequired Boolean @default(true) @map("recording_consent_required")
  retentionDays            Int     @default(30) @map("retention_days")
  autoDeleteTranscripts    Boolean @default(false) @map("auto_delete_transcripts")
  allowAudioStorage        Boolean @default(false) @map("allow_audio_storage")

  botDisplayVersion Int @default(0) @map("bot_display_version")
  botDisplayChanges BotDisplayChange[]

  bootstrapTokenHash String? @map("bootstrap_token_hash")
  bootstrapExpiresAt DateTime? @map("bootstrap_expires_at") @db.Timestamptz(3)
  bootstrapConsumedAt DateTime? @map("bootstrap_consumed_at") @db.Timestamptz(3)

  setupCompleted   Boolean   @default(false) @map("setup_completed")
  setupCompletedAt DateTime? @map("setup_completed_at")
  productVersion   String    @default("0.0.1") @map("product_version")
  installationId   String    @unique @default(uuid()) @map("installation_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model License {
  id               String        @id @default(uuid()) @db.Uuid
  singletonKey     String        @unique @map("singleton_key")
  licenseKeyHash   String?       @map("license_key_hash")
  customerName     String        @map("customer_name")
  installationId   String        @map("installation_id") @db.Uuid
  status           LicenseStatus @default(ACTIVE)
  edition          LicenseEdition
  issuedAt         DateTime?     @map("issued_at")
  activatedAt      DateTime?     @map("activated_at")
  updatesExpiresAt DateTime?     @map("updates_expires_at")
  supportExpiresAt DateTime?     @map("support_expires_at")
  enabledFeatures  String[]      @default([]) @map("enabled_features")
  licensePayload   Json?         @map("license_payload")
  signature        String?
  lastVerifiedAt   DateTime?     @map("last_verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("licenses")
}

model User {
 exports ExportRequest[]
  id               String   @id @default(uuid()) @db.Uuid
  email            String   @unique
  name             String
  role             SystemRole @default(MEMBER)
  passwordHash     String   @map("password_hash")
  isActive         Boolean  @default(true) @map("is_active")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  tokenVersion     Int      @default(0) @map("token_version")
  refreshTokenHash String?  @map("refresh_token_hash")
  lastLoginAt      DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  administrativeResetToken AdministrativeResetToken? @relation("AdministrativeResetTarget")
  administrativeResetsIssued AdministrativeResetToken[] @relation("AdministrativeResetIssuer")
  administrativeResetEvents AdministrativeResetEvent[] @relation("AdministrativeResetEventTarget")
  administrativeResetEventsIssued AdministrativeResetEvent[] @relation("AdministrativeResetEventIssuer")
  activationToken ActivationToken? @relation("ActivationTarget")
  activationsIssued ActivationToken[] @relation("ActivationIssuer")
  activationEvents ActivationEvent[] @relation("ActivationEventTarget")
  activationEventsIssued ActivationEvent[] @relation("ActivationEventIssuer")
  ownerRecoveryToken OwnerRecoveryToken?
  ownerRecoveryEvents OwnerRecoveryEvent[]
  wizardActivations WizardActivation[]
  setupDrafts SetupDraft[]
  setupDraftEvents SetupDraftEvent[]
  departmentMemberships DepartmentMembership[]
  membershipEvents MembershipEvent[] @relation("MembershipTarget")
  membershipEventsActed MembershipEvent[] @relation("MembershipActor")
  authSessions AuthSession[]
  botDisplayChanges BotDisplayChange[]
  departmentActivationEvents DepartmentActivationEvent[]
  createdMeetings Meeting[] @relation("MeetingCreator")
  managedMeetings Meeting[] @relation("MeetingManager")
  meetingAccess MeetingAccess[]
  meetingCreateRequests MeetingCreateRequest[]
  meetingCreationAudit MeetingCreationAudit[]
  cancellationRequests CancellationRequest[]
  cancellationSubmissions CancellationSubmission[]
  cancellationRequestAudit CancellationRequestAudit[]
  cancellationDecisions CancellationDecision[]
  cancellationsDecided CancellationRequest[] @relation("CancellationDecider")
  notifications Notification[] @relation("NotificationRecipient")

  @@map("users")
}

model AuthSession {
  id              String    @id @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  refreshHash     String    @unique @map("refresh_hash")
  tokenVersion    Int       @map("token_version")
  rotationCounter Int       @default(0) @map("rotation_counter")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model BotDisplayChange {
  id String @id @default(uuid()) @db.Uuid
  settingsId String @map("settings_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  version Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  settings SystemSetting @relation(fields: [settingsId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([settingsId, version])
  @@map("bot_display_changes")
}

enum DepartmentKind {
  TECH
  SALES
}

enum DepartmentStatus {
  DISABLED
  ACTIVE
}

model Department {
  id String @id @default(uuid()) @db.Uuid
  kind DepartmentKind @unique
  status DepartmentStatus @default(DISABLED)
  version Int @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  activationEvents DepartmentActivationEvent[]
  memberships DepartmentMembership[]
  membershipEvents MembershipEvent[]
  meetings Meeting[]

  @@map("departments")
}

model DepartmentActivationEvent {
  id String @id @default(uuid()) @db.Uuid
  departmentId String @map("department_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  fromStatus DepartmentStatus? @map("from_status")
  toStatus DepartmentStatus @map("to_status")
  version Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([departmentId, version])
  @@map("department_activation_events")
}

model OwnerRecoveryToken {
  userId String @id @map("user_id") @db.Uuid
  digest String
  tokenVersion Int @map("token_version")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  issuedAt DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@map("owner_recovery_tokens")
}

model OwnerRecoveryEvent {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  action String
  tokenVersion Int @map("token_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId])
  @@map("owner_recovery_events")
}

model AdministrativeResetToken {
  userId String @id @map("user_id") @db.Uuid
  issuerId String @map("issuer_id") @db.Uuid
  targetRole SystemRole @map("target_role")
  tokenVersion Int @map("token_version")
  issuerTokenVersion Int @map("issuer_token_version")
  digest String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  issuedAt DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)
  user User @relation("AdministrativeResetTarget", fields: [userId], references: [id], onDelete: Restrict)
  issuer User @relation("AdministrativeResetIssuer", fields: [issuerId], references: [id], onDelete: Restrict)
  @@index([issuerId])
  @@map("administrative_reset_tokens")
}

model AdministrativeResetEvent {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  issuerId String @map("issuer_id") @db.Uuid
  tokenVersion Int @map("token_version")
  action String
  requestHash String? @map("request_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation("AdministrativeResetEventTarget", fields: [userId], references: [id], onDelete: Restrict)
  issuer User @relation("AdministrativeResetEventIssuer", fields: [issuerId], references: [id], onDelete: Restrict)
  @@unique([userId, tokenVersion, action], map: "admin_reset_event_once")
  @@unique([issuerId, userId, requestHash], map: "admin_reset_request_once")
  @@index([issuerId])
  @@map("administrative_reset_events")
}

model ActivationToken {
  userId String @id @map("user_id") @db.Uuid
  issuerId String @map("issuer_id") @db.Uuid
  targetRole SystemRole @map("target_role")
  tokenVersion Int @map("token_version")
  issuerTokenVersion Int @map("issuer_token_version")
  digest String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  issuedAt DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)
  user User @relation("ActivationTarget", fields: [userId], references: [id], onDelete: Restrict)
  issuer User @relation("ActivationIssuer", fields: [issuerId], references: [id], onDelete: Restrict)
  @@index([issuerId])
  @@map("activation_tokens")
}

model ActivationEvent {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  issuerId String @map("issuer_id") @db.Uuid
  tokenVersion Int @map("token_version")
  action String
  requestHash String? @map("request_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation("ActivationEventTarget", fields: [userId], references: [id], onDelete: Restrict)
  issuer User @relation("ActivationEventIssuer", fields: [issuerId], references: [id], onDelete: Restrict)
  @@unique([userId, tokenVersion, action], map: "activation_event_once")
  @@unique([issuerId, requestHash], map: "activation_request_once")
  @@index([issuerId])
  @@map("activation_events")
}

enum DepartmentRole {
  ADMIN
  MEMBER
}

model DepartmentMembership {
  id String @id @default(uuid()) @db.Uuid
  departmentId String @map("department_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role DepartmentRole
  canCreateMeetings Boolean @default(false) @map("can_create_meetings")
  canManageMeetings Boolean @default(false) @map("can_manage_meetings")
  canApproveMeetings Boolean @default(false) @map("can_approve_meetings")
  version Int @default(1)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  department Department @relation(fields:[departmentId],references:[id],onDelete:Restrict)
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  @@unique([departmentId,userId])
  @@index([userId])
  @@map("department_memberships")
}

model MembershipEvent {
  id String @id @default(uuid()) @db.Uuid
  departmentId String @map("department_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  version Int
  action String
  requestHash String @map("request_hash")
  snapshot Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  department Department @relation(fields:[departmentId],references:[id],onDelete:Restrict)
  user User @relation("MembershipTarget",fields:[userId],references:[id],onDelete:Restrict)
  actor User @relation("MembershipActor",fields:[actorId],references:[id],onDelete:Restrict)
  @@unique([departmentId,userId,version])
  @@unique([actorId,requestHash])
  @@index([userId])
  @@map("membership_events")
}

model SetupDraft {
  id String @id @default(uuid()) @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  version Int @default(1)
  data Json
  baseSettings Json @map("base_settings")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastActivityAt DateTime @map("last_activity_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  actor User @relation(fields:[actorId],references:[id],onDelete:Restrict)
  activation WizardActivation?
  events SetupDraftEvent[]
  @@index([actorId,expiresAt])
  @@map("setup_drafts")
}
model SetupDraftEvent {
  id String @id @default(uuid()) @db.Uuid
  draftId String @map("draft_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  version Int
  action String
  requestHash String @map("request_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  draft SetupDraft @relation(fields:[draftId],references:[id],onDelete:Restrict)
  actor User @relation(fields:[actorId],references:[id],onDelete:Restrict)
  @@unique([draftId,version])
  @@unique([actorId,requestHash])
  @@map("setup_draft_events")
}

model WizardActivation {
 id String @id @default(uuid()) @db.Uuid
 settingsId String @unique @map("settings_id") @db.Uuid
 draftId String @unique @map("draft_id") @db.Uuid
 actorId String @map("actor_id") @db.Uuid
 requestHash String @map("request_hash")
 requestDigest String @map("request_digest")
 result Json
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 settings SystemSetting @relation(fields:[settingsId],references:[id],onDelete:Restrict)
 draft SetupDraft @relation(fields:[draftId],references:[id],onDelete:Restrict)
 actor User @relation(fields:[actorId],references:[id],onDelete:Restrict)
 outbox SetupOutbox?
 @@unique([actorId,requestHash])
 @@map("wizard_activations")
}
model SetupOutbox {
 id String @id @default(uuid()) @db.Uuid
 activationId String @unique @map("activation_id") @db.Uuid
 topic String
 payload Json
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(3)
 activation WizardActivation @relation(fields:[activationId],references:[id],onDelete:Restrict)
 @@map("setup_outbox")
}

model Meeting {
 exports ExportRequest[]
 analysisRuns AnalysisRun[]
  id String @id @db.Uuid
  kind String
  departmentId String? @map("department_id") @db.Uuid
  visibility String
  title String @db.VarChar(240)
  createdById String @map("created_by_id") @db.Uuid
  meetingAdminId String @map("meeting_admin_id") @db.Uuid
  lifecycle String @default("DRAFT")
  version Int @default(0)
  scheduleVersion Int @default(0) @map("schedule_version")
  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz(3)
  timeZone String? @map("time_zone") @db.VarChar(80)
  joinUrl String? @map("join_url") @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  creator User @relation("MeetingCreator", fields:[createdById], references:[id], onDelete:Restrict)
  manager User @relation("MeetingManager", fields:[meetingAdminId], references:[id], onDelete:Restrict)
  department Department? @relation(fields:[departmentId], references:[id], onDelete:Restrict)
  access MeetingAccess[] @relation("MeetingAccessEntries")
  managerAccess MeetingAccess @relation("AssignedManagerAccess", fields:[id,meetingAdminId], references:[meetingId,userId], onDelete:NoAction,onUpdate:NoAction)
  requests MeetingCreateRequest[]
  creationAudit MeetingCreationAudit[]
  cancellationRequests CancellationRequest[]
  botSessions BotSession[]
  transcriptInbox TranscriptInbox[]
  transcripts Transcript[]
  transcriptSegments TranscriptSegment[]
  @@index([departmentId,createdAt,id])
  @@index([meetingAdminId,lifecycle])
  @@map("meetings")
}

model MeetingAccess {
  meetingId String @map("meeting_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role String
  canReadTranscript Boolean @default(false) @map("can_read_transcript")
  meeting Meeting @relation("MeetingAccessEntries", fields:[meetingId],references:[id],onDelete:Restrict)
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  assignedMeetings Meeting[] @relation("AssignedManagerAccess")
  @@id([meetingId,userId])
  @@map("meeting_access")
}

model MeetingCreateRequest {
  actorId String @map("actor_id") @db.Uuid
  keyHash String @map("key_hash") @db.VarChar(64)
  payloadHash String @map("payload_hash") @db.VarChar(64)
  meetingId String @map("meeting_id") @db.Uuid
  response Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor User @relation(fields:[actorId],references:[id],onDelete:Restrict)
  meeting Meeting @relation(fields:[meetingId],references:[id],onDelete:Restrict)
  @@id([actorId,keyHash])
  @@map("meeting_create_requests")
}

model MeetingCreationAudit {
  id String @id @db.Uuid
  meetingId String @map("meeting_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  action String @default("meeting.created.v1")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor User @relation(fields:[actorId],references:[id],onDelete:Restrict)
  meeting Meeting @relation(fields:[meetingId],references:[id],onDelete:Restrict)
  @@index([meetingId])
  @@map("meeting_creation_audit")
}

model OutboxEvent {
  id String @id @db.Uuid
  type String
  aggregateId String @map("aggregate_id") @db.Uuid
  aggregateVersion Int @map("aggregate_version")
  payload Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(3)


  aggregateType String @default("Meeting") @map("aggregate_type")
  eventVersion Int @default(1) @map("event_version")
  correlationId String? @map("correlation_id")
  causationId String? @map("causation_id")
  attempts Int @default(0)
  nextRetryAt DateTime? @map("next_retry_at") @db.Timestamptz(3)
  lockedBy String? @map("locked_by")
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)
  inboxReceipts InboxReceipt[]
  @@index([dispatchedAt,createdAt,id])
  @@index([dispatchedAt,nextRetryAt,createdAt,id], map:"outbox_dispatch_due_idx")
  @@map("outbox_events")
}




model InboxReceipt {
  id String @id
  consumer String
  eventId String @map("event_id")
  sourceOutboxEventId String? @map("source_outbox_event_id") @db.Uuid
  processedAt DateTime @map("processed_at") @db.Timestamptz(3)
  outcome String
  sourceEvent OutboxEvent? @relation(fields:[sourceOutboxEventId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  @@unique([consumer,eventId],map:"inbox_receipts_consumer_event_key")
  @@map("inbox_receipts")
}



model Notification {
  id String @id
  recipientUserId String @map("recipient_user_id") @db.Uuid
  kind String
  resourceId String @map("resource_id")
  bodySafe String @map("body_safe")
  state String
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  seenAt DateTime? @map("seen_at") @db.Timestamptz(3)
  recipient User @relation("NotificationRecipient",fields:[recipientUserId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  deliveries NotificationDelivery[]
  @@index([recipientUserId,seenAt,createdAt,id],map:"notifications_recipient_page_idx")
  @@map("notifications")
}

model NotificationDelivery {
  id String @id
  notificationId String @map("notification_id")
  channel String
  attempt Int
  status String
  externalMessageId String? @map("external_message_id")
  notification Notification @relation(fields:[notificationId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  @@unique([notificationId,channel,attempt],map:"notification_deliveries_channel_attempt_key")
  @@map("notification_deliveries")
}

model CancellationRequest {
 id String @id @db.Uuid
 meetingId String @map("meeting_id") @db.Uuid
 requestedById String @map("requested_by_id") @db.Uuid
 reason String @db.VarChar(1000)
 decidedById String? @map("decided_by_id") @db.Uuid
 decisionAt DateTime? @map("decision_at") @db.Timestamptz(3)
 decisionReason String? @map("decision_reason") @db.VarChar(1000)
 status String @default("REQUESTED")
 version Int @default(0)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 meeting Meeting @relation(fields:[meetingId],references:[id],onDelete:Restrict)
 requester User @relation(fields:[requestedById],references:[id],onDelete:Restrict)
 decider User? @relation("CancellationDecider",fields:[decidedById],references:[id],onDelete:Restrict)
 submissions CancellationSubmission[]
 audit CancellationRequestAudit[]
 decisions CancellationDecision[]

 @@index([requestedById])
 @@index([decidedById])
 @@map("cancellation_requests")
}

model CancellationSubmission {
 actorId String @map("actor_id") @db.Uuid
 keyHash String @map("key_hash") @db.VarChar(64)
 payloadHash String @map("payload_hash") @db.VarChar(64)
 requestId String @map("request_id") @db.Uuid
 response Json
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 actor User @relation(fields:[actorId],references:[id],onDelete:Restrict)
 request CancellationRequest @relation(fields:[requestId],references:[id],onDelete:Restrict)
 @@id([actorId,keyHash])
 @@map("cancellation_submissions")
}

model CancellationRequestAudit {
 id String @id @db.Uuid
 requestId String @map("request_id") @db.Uuid
 actorId String @map("actor_id") @db.Uuid
 action String @default("cancellation.requested.v1")
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 request CancellationRequest @relation(fields:[requestId],references:[id],onDelete:Restrict)
 actor User @relation(fields:[actorId],references:[id],onDelete:Restrict)
 @@index([requestId])
 @@map("cancellation_request_audit")
}

model CancellationDecision {
 actorId String @map("actor_id") @db.Uuid
 keyHash String @map("key_hash") @db.VarChar(64)
 payloadHash String @map("payload_hash") @db.VarChar(64)
 requestId String @map("request_id") @db.Uuid
 response Json
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 actor User @relation(fields:[actorId],references:[id],onDelete:Restrict)
 request CancellationRequest @relation(fields:[requestId],references:[id],onDelete:Restrict)
 @@id([actorId,keyHash])
 @@map("cancellation_decisions")
}


model BotSession {
 id String @id @db.Uuid
